{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    // Ambient type packages, and the list is CLOSED rather than empty: `[]`
    // was the point before WebGPU, and one entry keeps that — @types/node and
    // whatever else lands in node_modules stay out of the global scope. The
    // one entry is the backend the game renders through, and `navigator.gpu`
    // is not in TypeScript's DOM lib.
    "types": ["@webgpu/types"]
  },
  "include": ["src", "main.ts"]
}

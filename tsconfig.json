{
  "compilerOptions": {
    "target": "ES2022",
    // [[Set]] class fields, not ES2022's [[Define]] — and that is a PERFORMANCE
    // setting (`FINDINGS.md` 61, `BABYLON_EXIT.md` X2.5b). Under [[Define]]
    // a field DECLARED without an initializer (`x: number;`, every `Vector3`)
    // is emitted as `x;`, which defines it as `undefined` before the
    // constructor stores a number; V8 then keeps the field TAGGED, and every
    // double stored into it afterwards is a fresh heap number. Measured: 12 B
    // a store, ~110 B a `BotMirror.read`. With this false the declaration
    // emits nothing and the constructor's first store decides the field.
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    // ES2024 for the growable `SharedArrayBuffer` the simulation's Worker
    // publishes through (`src/sim/publication.ts`, BABYLON_EXIT.md X2.5b).
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    // A module a Node SCRIPT imports straight out of `src/` (a generator
    // importing `world/roadPaths.ts`) is loaded by Node's type stripping,
    // which resolves no extensionless specifier — so its value imports name
    // the `.ts`, and this lets `tsc` accept that.
    "allowImportingTsExtensions": true,
    // Ambient type packages, and the list is CLOSED rather than empty: `[]`
    // was the point before WebGPU, and one entry keeps that — @types/node and
    // whatever else lands in node_modules stay out of the global scope. The
    // one entry is the backend the game renders through, and `navigator.gpu`
    // is not in TypeScript's DOM lib.
    "types": ["@webgpu/types"]
  },
  "include": ["src", "main.ts"]
}

# Everything the image build must not carry. The build stage COPYs explicit
# paths, so this is belt-and-braces plus a smaller build context.
.git
.gitignore
node_modules
dist
tmp_shots
undefined
models
specs
# NOT scripts/: the build stage COPYs it, because `npm run build` runs
# scripts/check-collision.mjs — the gate that refuses a bake older than the
# layout it came from. Excluding it fails the image build at the COPY.
*.md
# ...except the spine, which `check-audio.mjs`'s CLAIMS table reads on the front
# of `npm run build` — see the COPY for it in the Dockerfile. `*.md` does not
# reach `docs/` (a pattern's `*` does not cross a `/`), so the companions it
# also reads need no line here; this one is the whole exception.
!CLAUDE.md
Dockerfile
.dockerignore
